# Production values belong in the hosting platform's secret manager. Do not commit real values.
SPEJ_RUNTIME=production
DATABASE_URL=postgresql://user:password@database.example.invalid:5432/spej

# Verified workforce identity (for example, Microsoft Entra ID via OIDC).
AUTH_ISSUER=https://login.example.invalid/tenant/v2.0
AUTH_AUDIENCE=spej-os
AUTH_CLIENT_ID=replace-with-client-id
SESSION_SECRET=replace-with-at-least-32-random-characters

# Durable audit/secret infrastructure selected by Spej IT.
AUDIT_LOG_SINK=replace-with-audit-sink
SECRETS_PROVIDER=replace-with-secret-manager
QUEUE_URL=replace-with-durable-queue-url

# Existing Spej OS dependency registry. These are service identifiers, not new
# duplicate databases. Production health must resolve and check every service.
SPEJ_SERVICE_REGISTRY_URL=https://services.example.invalid
SPEJ_CANONICAL_SERVICE_ID=replace-with-canonical-record-service-id
SPEJ_KNOWLEDGE_SERVICE_ID=replace-with-knowledge-service-id
SPEJ_TICKETS_QUALITY_SERVICE_ID=replace-with-ticket-quality-service-id
SPEJ_FEATURE_CONTROL_SERVICE_ID=replace-with-feature-control-service-id
SPEJ_USAGE_REPORTING_SERVICE_ID=replace-with-usage-reporting-service-id

# Optional Microsoft adapter. Setting this to true makes every listed value mandatory.
MICROSOFT_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Prefer workload_identity; use client_secret only when Spej IT approves it.
MICROSOFT_CREDENTIAL_MODE=workload_identity
MICROSOFT_CLIENT_SECRET=
MICROSOFT_WEBHOOK_CLIENT_STATE=

# Optional existing-SOSA adapter. This repository does not provide the SOSA service.
SOSA_ENABLED=false
SOSA_SERVICE_URL=
SOSA_AUDIENCE=

# Telemetry is a production adapter choice.
OTEL_EXPORTER_OTLP_ENDPOINT=
