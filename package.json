{
  "name": "spej-control-center",
  "version": "0.6.0",
  "description": "A local-first Spej OS preview with connected My Work, CRM, GTM, Projects, and SOSA views.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "launch": "node scripts/launch.mjs",
    "demo": "node scripts/demo.mjs",
    "company-demo": "node scripts/company-demo.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "ingest": "node scripts/ingest.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
